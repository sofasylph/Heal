# Backend
DATABASE_URL=sqlite:///./claimtrace.db
CORS_ORIGINS=http://localhost:3000
CLAIMTRACE_SEED=1
# LLM clause reasoner: none | claude
CLAIMTRACE_LLM_PROVIDER=none
CLAIMTRACE_LLM_MODEL=claude-opus-5-5
CLAIMTRACE_LLM_EFFORT=high
# Optional JSONL response cache (makes reruns free and deterministic)
# CLAIMTRACE_LLM_CACHE=./llm_cache.jsonl
# Needed only when CLAIMTRACE_LLM_PROVIDER=claude (or use `ant auth login`)
# ANTHROPIC_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
DATABASE_URL=sqlite:///./claimtrace.db
CORS_ORIGINS=http://localhost:3000
CLAIMTRACE_SEED=1
# Initial model settings (changeable later on the Settings page by a senior reviewer)
CLAIMTRACE_DOC_CLASSIFIER=tfidf_logreg        # keyword | tfidf_logreg
CLAIMTRACE_ANOMALY_DETECTOR=hybrid            # rules | isolation_forest | hybrid
# LLM clause reasoner: none | claude | ollama
CLAIMTRACE_LLM_PROVIDER=none
CLAIMTRACE_LLM_MODEL=claude-opus-5-5
CLAIMTRACE_LLM_EFFORT=high
# Local open-weights model via Ollama (https://ollama.com): `ollama pull qwen3:8b`
CLAIMTRACE_OLLAMA_MODEL=qwen3:8b
CLAIMTRACE_OLLAMA_URL=http://localhost:11434
# Optional JSONL response cache (makes reruns free and deterministic)
# CLAIMTRACE_LLM_CACHE=./llm_cache.jsonl
# Needed only when CLAIMTRACE_LLM_PROVIDER=claude (or use `ant auth login`)
# ANTHROPIC_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
